# Read-only discovery: X API bearer token with access to user lookup and timelines.
# Publishing credentials are configured separately in the Node service.
X_READ_BEARER_TOKEN=
X_WATCH_ACCOUNTS=cz_binance,heyibinance,binance,binancezh
X_PAGE_SIZE=20
X_MAX_PAGES=2
X_INCLUDE_REPLIES=true
SCRAPE_INTERVAL_SECONDS=300
