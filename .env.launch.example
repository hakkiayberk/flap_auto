# User-context OAuth 2.0 token, with tweet.write, tweet.read and users.read.
# Never use an app-only bearer token for creating a post.
X_USER_ACCESS_TOKEN=
X_EXPECTED_USER_ID=
# Live deploy stays disabled until configuration and end-to-end validation.
ENABLE_LIVE_DEPLOY=false
# Supply signer credentials through the server environment, never HTTP requests.
KEYSTORE_PASSWORD=
