# Terminal modunda Telegram alanları BOŞ kalabilir. İsteğe bağlı Telegram modu için:
# BotFather token; yalnızca kendi sunucunuzda doldurun.
TELEGRAM_BOT_TOKEN=
# Telegram özel sohbetinizde sayısal kullanıcı ID = chat ID.
TELEGRAM_OWNER_ID=
RPC_URLS=https://your-primary-bsc-rpc,https://your-secondary-bsc-rpc
# Başlangıçta yalnızca quote/simülasyon; işlem imzalanmaz/gönderilmez.
MODE=dry-run
AMOUNT_BNB=0.005
SLIPPAGE_BPS=500
MAX_PER_WALLET_BNB=0.05
MAX_BATCH_BNB=0.25
MAX_SESSION_BNB=0.5
MAX_GAS_PRICE_GWEI=5
GAS_RESERVE_BNB=0.002
CACHE_MAX_AGE_MS=15000
QUOTE_MAX_AGE_MS=5000
ARM_MINUTES=15
WALLETS_FILE=./data/wallets.enc.json
# Dry-run için imzasız adres listesi. Canlı modda şifreli dosya kullanılır.
WATCH_WALLETS_FILE=./watch-wallets.json
