{
  "name": "flap-quick-buy",
  "version": "1.0.0",
  "description": "Terminal and Telegram Flap BSC quick-buy bot",
  "main": "dist/terminal.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "dev": "node --import tsx src/terminal.ts",
    "build": "tsc",
    "start": "node dist/terminal.js",
    "wallets:import": "node --import tsx src/import-wallets.ts",
    "telegram:id": "node --import tsx src/telegram-id.ts",
    "start:terminal": "node dist/terminal.js",
    "start:telegram": "node dist/index.js",
    "dev:telegram": "node --import tsx src/index.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "dotenv": "^18.0.5",
    "twitter-text": "^3.1.0",
    "viem": "^2.57.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/twitter-text": "^3.1.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "private": true
}
